#!/usr/bin/env bash
<%# Main script of the Lumerical DEVICE suite app (runs inside the Slurm
    job under the VNC display started by the OOD vnc template — $DISPLAY is
    already set by the template's run_script). -%>
set -euo pipefail

echo "Starting Lumerical DEVICE suite on $(hostname) (display ${DISPLAY:-?})"

# APP_CMD is exported by before.sh (form value "command"); fall back to the
# standard launcher name. The software must be installed and on PATH on the
# compute node (licensed product — see README.md).
CMD="${APP_CMD:-lumerical}"

# shellcheck disable=SC2086
exec ${CMD}
