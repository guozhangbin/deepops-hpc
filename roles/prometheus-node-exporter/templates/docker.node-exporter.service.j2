[Unit]
Description=Prometheus Node Exporter
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
PartOf=docker.service

[Service]
TimeoutStartSec=0
Restart=always
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
# Retry the pull: at boot the network may not be up yet, and a failed burst
# hits systemd's StartLimitBurst, leaving the service dead until manual
# reset-failed. ~60s of retries ride out slow network/DNS bring-up.
ExecStartPre=/bin/sh -c 'for i in 1 2 3 4 5 6; do /usr/bin/docker pull {{ node_exporter_container }} && exit 0; sleep 10; done; /usr/bin/docker pull {{ node_exporter_container }}'
ExecStart=/usr/bin/docker run --rm --network host --cpus={{ node_exporter_max_cpu }}  --pid=host --name %n -v {{ node_exporter_prom_dir }}:/run/prometheus {{ node_exporter_container }} --collector.textfile.directory="{{ node_exporter_prom_dir }}"

[Install]
WantedBy=multi-user.target
