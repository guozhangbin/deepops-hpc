[Unit]
Description=NVIDIA DCGM Exporter
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
PartOf=docker.service

[Service]
TimeoutStartSec=0
Restart=always
ExecStartPre=-/usr/bin/docker stop %n
ExecStartPre=-/usr/bin/docker rm %n
# Retry the pull: at boot the network may not be up yet, and a failed burst
# hits systemd's StartLimitBurst, leaving the service dead until manual
# reset-failed. ~60s of retries ride out slow network/DNS bring-up.
ExecStartPre=/bin/sh -c 'for i in 1 2 3 4 5 6; do /usr/bin/docker pull {{ nvidia_dcgm_container }} && exit 0; sleep 10; done; /usr/bin/docker pull {{ nvidia_dcgm_container }}'
ExecStart=/usr/bin/docker run --rm --gpus all --cap-add=SYS_ADMIN --cpus="{{ nvidia_dcgm_max_cpu }}" --name %n -p 9400:9400 -v "{{ nvidia_dcgm_container_config_dir }}/{{ nvidia_dcgm_container_custom_metrics_file }}:/etc/dcgm-exporter/default-counters.csv" {{ nvidia_dcgm_container }}

[Install]
WantedBy=multi-user.target
